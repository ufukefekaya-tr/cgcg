# Local synthetic workspace. No production credentials or machine data.
PORT=4310
CGCG_HOST=127.0.0.1
CGCG_DATA_DIR=.data
CGCG_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://127.0.0.1:5175,http://localhost:5175
CGCG_RATE_LIMIT=600
# Optional Gemini assistance; disabled until explicitly enabled/configured.
CGCG_AI_ENABLED=false
CGCG_AI_MODEL=
GEMINI_API_KEY=
